{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/dragginzgame/icydb-explorer/*"
        },
        {
          "url": "https://github.com/dragginzgame/icydb-explorer/**"
        }
      ]
    }
  ]
}
